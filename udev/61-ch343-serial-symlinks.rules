# Recreate /dev/serial/by-id and /dev/serial/by-path for WCH ch343 ports.
#
# The stock /usr/lib/udev/rules.d/60-serial.rules bails out at
#     KERNEL!="ttyUSB[0-9]*|ttyACM[0-9]*", GOTO="serial_end"
# so ttyCH343USB* never gets its symlinks -- even though that same file has
# already run IMPORT{builtin}="usb_id" by then, so every property we need is
# present. This file redoes the second half of 60-serial.rules for the ch343
# naming scheme. Must sort after 60-serial.rules.

ACTION=="remove", GOTO="ch343_end"
SUBSYSTEM!="tty", GOTO="ch343_end"
KERNEL!="ttyCH343USB[0-9]*", GOTO="ch343_end"

IMPORT{builtin}="path_id"
ENV{ID_PATH}=="?*", SYMLINK+="serial/by-path/$env{ID_PATH}"

IMPORT{builtin}="usb_id"
ENV{ID_SERIAL}=="", GOTO="ch343_end"
SUBSYSTEMS=="usb", ENV{ID_USB_INTERFACE_NUM}="$attr{bInterfaceNumber}"
ENV{ID_USB_INTERFACE_NUM}=="", GOTO="ch343_end"
SYMLINK+="serial/by-id/$env{ID_BUS}-$env{ID_SERIAL}-if$env{ID_USB_INTERFACE_NUM}"

# Short per-UART aliases: /dev/xkwy-<chip serial>-p1 .. -p4
# Keyed on the chip's own serial number, so two identical adapters never
# collide and the names survive reboots, replugs and enumeration order.
ENV{ID_VENDOR_ID}!="1a86", GOTO="ch343_end"
ENV{ID_MODEL_ID}!="55d5", GOTO="ch343_end"
ENV{ID_USB_INTERFACE_NUM}=="00", SYMLINK+="xkwy-$env{ID_SERIAL_SHORT}-p1"
ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="xkwy-$env{ID_SERIAL_SHORT}-p2"
ENV{ID_USB_INTERFACE_NUM}=="04", SYMLINK+="xkwy-$env{ID_SERIAL_SHORT}-p3"
ENV{ID_USB_INTERFACE_NUM}=="06", SYMLINK+="xkwy-$env{ID_SERIAL_SHORT}-p4"

LABEL="ch343_end"
